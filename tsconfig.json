{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "jsx": "react-jsx",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "components/*": ["./components/*"]
    },
    "types": ["node"]
  },
  "include": ["src"]
}
